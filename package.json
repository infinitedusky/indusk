{
	"name": "dusk",
	"private": true,
	"packageManager": "pnpm@10.33.0",
	"scripts": {
		"test": "turbo test",
		"check": "biome check",
		"check:fix": "biome check --write",
		"format": "biome format --write",
		"dev:docs": "turbo dev --filter=@infinitedusky/docs",
		"build:docs": "turbo build --filter=@infinitedusky/docs",
		"start:docs": "turbo start --filter=@infinitedusky/docs",
		"dev": "turbo dev",
		"build": "turbo build",
		"start": "turbo start",
		"release": "pnpm --filter @infinitedusky/indusk-mcp release"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.1",
		"turbo": "^2.10.0",
		"vitest": "^4.1.9"
	}
}
