{
	"name": "dusk",
	"private": true,
	"packageManager": "pnpm@10.33.0",
	"scripts": {
		"ce": "ce",
		"test": "turbo test",
		"check": "biome check",
		"check:fix": "biome check --write",
		"format": "biome format --write",
		"env:build": "ce build --profile",
		"dev:docs": "ce run --profile -- turbo dev --filter=@infinitedusky/docs",
		"build:docs": "ce run --profile -- turbo build --filter=@infinitedusky/docs",
		"start:docs": "ce run --profile -- turbo start --filter=@infinitedusky/docs",
		"dev": "ce run -- turbo dev",
		"build": "ce run -- turbo build",
		"start": "ce run -- turbo start",
		"env:start": "ce start"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.8",
		"composable.env": "^1.37.2",
		"turbo": "^2.4.0",
		"vitest": "^4.1.0"
	}
}
