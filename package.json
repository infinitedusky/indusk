{
	"name": "dusk",
	"private": true,
	"packageManager": "pnpm@10.33.0",
	"scripts": {
		"test": "node apps/indusk-mcp/scripts/with-daemon-guard.js --mark everyday-suite-stays-fast sh -c 'turbo test && pnpm promises:check'",
		"e2e": "pnpm --filter @infinitedusky/indusk-mcp build && pnpm --filter @infinitedusky/indusk-mcp e2e",
		"test:system": "sh -c 'pnpm --filter @infinitedusky/indusk-mcp test:system; mcp=$?; pnpm --filter indusk-admin test:system; admin=$?; pnpm --filter indusk test:system; ext=$?; [ $mcp -eq 0 ] && [ $admin -eq 0 ] && [ $ext -eq 0 ]'",
		"promises:check": "node apps/indusk-mcp/dist/bin/cli.js promises check",
		"install:local": "pnpm --filter @infinitedusky/indusk-mcp prepublishOnly && npm install -g ./apps/indusk-mcp",
		"check": "biome check",
		"check:fix": "biome check --write",
		"format": "biome format --write",
		"dev:docs": "turbo dev --filter=@infinitedusky/docs",
		"build:docs": "turbo build --filter=@infinitedusky/docs",
		"start:docs": "turbo start --filter=@infinitedusky/docs",
		"dev": "turbo dev",
		"build": "turbo build",
		"start": "turbo start",
		"release": "pnpm --filter @infinitedusky/indusk-mcp release"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"turbo": "^2.11.2",
		"vitest": "^4.1.11"
	}
}
