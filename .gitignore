codegraph_viz.html

# ce:start
env/.env.secrets.local
env/.env.local
env/execution/*.cjs
# Legacy patterns
.ce.*
# ce:end
# docker-compose.yml is hand-written (doppler extension) — env comes from
# apps/*/.env.* via env_file, so the compose file itself carries no secrets.
# Generated by composable.env (contains secrets)
docker-compose.persistent.yml
apps/docs/src/.vitepress/cache/
apps/docs/src/.vitepress/dist/
# Telemetry binary cache from the Phase 1 spike + build script downloads
# (upstream Jaeger + otelcol tarballs, extracted work dirs). Regenerated
# on demand by scripts/build-telemetry-binaries.sh; never committed.
.cache/telemetry-binaries/

# MCP config (contains auth tokens)
.mcp.json
# InDusk managed
# Session-specific handoff (not project knowledge)
.claude/handoff.md
# Semantic graph event log (large, local-only)
.indusk/graph/
# Eval results (local-only)
.indusk/eval/
# Extension manifests are package-owned; env files contain secrets
.indusk/extensions/

# Sub-app .claude/ and .indusk/ dirs — these should only exist at the
# repo root. They get accidentally created when `indusk init` or
# `indusk update` is run from inside a sub-app directory. The 1.16.1
# CLI fix walks up to find the real project root, but this gitignore is
# the belt-and-suspenders so accidents don't land in commits.
apps/*/.claude/
apps/*/.indusk/

# Private interview prep — never commit
.indusk/interview/

.certs/
# Generated by composable.env (contains secrets)
docker-compose.local.yml
# Generated by composable.env (contains secrets)
docker-compose.production.yml

nginx.staging.conf

nginx.production.conf

Caddyfile
