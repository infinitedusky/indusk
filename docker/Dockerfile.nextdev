# Next.js local development — hot reload via volume mounts
# GENERATED by composable.env (ce init / scaffold:sync). Per-app COPY lines
# below are auto-enumerated from env/contracts/*.contract.json. Re-run
# scaffold:sync after adding a new app contract.
FROM node:20-alpine

RUN corepack enable && corepack prepare pnpm@latest --activate

# Caddy for TLS termination (:443 HTTPS, :80 HTTP redirect)
RUN apk add --no-cache caddy

WORKDIR /app

# Workspace manifests (cached layer — only invalidated when manifests change)
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
# Per-app package.json files (auto-enumerated from contracts on scaffold:sync)
COPY apps/docs/package.json apps/docs/
COPY apps/indusk-docs/package.json apps/indusk-docs/
RUN pnpm install --frozen-lockfile

# Entrypoint bypasses turbo — env vars pass through to the app
COPY docker/app-entrypoint.sh /usr/local/bin/app-entrypoint.sh

# Source code comes from volume mounts — not copied
# docker-compose volumes: ["./apps/myapp:/app/apps/myapp"]

# command: in docker-compose passes the pnpm filter name as $1
ENTRYPOINT ["/usr/local/bin/app-entrypoint.sh"]
