# InDusk: combine per-agent section additions on merge
.indusk/current.md merge=union

# InDusk: the verify ledger is append-only evidence — concurrent verifications
# on different branches must both survive a merge, never clobber each other.
.indusk/verify/ledger.jsonl merge=union

# InDusk: the phase-boundary record is the same shape of artifact, and
# worktree-per-plan is the default — two plans opening phases on two branches is
# the expected case. Losing either append loses a phase's scope.
.indusk/phase-boundary.jsonl merge=union

# InDusk: the highlights queue and its processed ledger are append-only too —
# the eval agent writes both on every branch it scores, and landing a plan
# branch conflicted on exactly this file (admin-ui-phase-progress, Step 10).
.indusk/highlights.jsonl merge=union
.indusk/highlights-processed.jsonl merge=union
