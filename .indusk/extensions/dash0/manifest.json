{
	"name": "dash0",
	"description": "Dash0 observability — query logs, traces, and metrics from your OpenTelemetry data via MCP and CLI",
	"provides": {
		"skill": true,
		"health_checks": [
			{
				"name": "dash0-mcp-configured",
				"command": "node -e \"const m=JSON.parse(require('fs').readFileSync('.mcp.json','utf-8'));process.exit(m.mcpServers?.dash0 ? 0 : 1)\""
			},
			{
				"name": "dash0-cli-installed",
				"command": "dash0 version --agent-mode"
			}
		]
	},
	"mcp_server": {
		"type": "http",
		"url": "DASH0_ENDPOINT_MCP",
		"headers": {
			"Authorization": "Bearer DASH0_AUTH_TOKEN"
		},
		"setup_instructions": [
			"1. Copy the template:",
			"   cp .indusk/extensions/dash0/.env.example .indusk/extensions/dash0/.env",
			"2. Edit .env and fill in:",
			"   - DASH0_AUTH_TOKEN (from Dash0 > Organization Settings > Auth Tokens)",
			"   - DASH0_DATASET, DASH0_ENDPOINT_MCP, OTEL_EXPORTER_OTLP_ENDPOINT",
			"   - OTEL_EXPORTER_OTLP_HEADERS (Bearer token + Dash0-Dataset)",
			"3. Run 'indusk extensions enable dash0' again (or 'indusk update')",
			"4. Optional: install CLI with 'brew install dash0hq/dash0-cli/dash0'"
		]
	},
	"hooks": {
		"on_enable": "echo 'Dash0 extension enabled.'"
	},
	"detect": {
		"mcp_server": "dash0"
	}
}
