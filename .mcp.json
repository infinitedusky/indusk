{
  "mcpServers": {
    "dash0": {
      "type": "http",
      "url": "https://api.europe-west4.gcp.dash0.com/mcp",
      "headers": {
        "Authorization": "Bearer ${DASH0_AUTH_TOKEN}"
      }
    },
    "indusk": {
      "type": "stdio",
      "command": "indusk",
      "args": [
        "serve"
      ],
      "env": {
        "PROJECT_ROOT": "."
      }
    },
    "jaeger": {
      "type": "http",
      "url": "http://localhost:54379/mcp"
    },
    "posthog": {
      "type": "http",
      "url": "https://mcp.posthog.com/mcp"
    }
  }
}
