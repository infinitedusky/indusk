{
  "mcpServers": {
    "indusk": {
      "type": "stdio",
      "command": "indusk",
      "args": [
        "serve"
      ],
      "env": {
        "PROJECT_ROOT": "."
      }
    },
    "jaeger": {
      "type": "http",
      "url": "http://localhost:63956/mcp"
    },
    "posthog": {
      "type": "http",
      "url": "https://mcp.posthog.com/mcp"
    }
  }
}