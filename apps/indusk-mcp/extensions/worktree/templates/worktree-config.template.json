{
	"$schema": "../../config.schema.json",
	"trunk_branch": "main",
	"base_branch": "main",
	"post_create": ["pnpm install"],
	"copy_files": [],
	"append_files": [],
	"apply_commits": [],
	"preflight": [
		{
			"name": "biome",
			"command": "pnpm biome check $CHANGED_FILES_BIOME",
