{
	"name": "posthog",
	"description": "PostHog user-behavior layer — query events, persons, insights, replays, flags, errors and experiments via PostHog's remote MCP server",
	"provides": {
		"skill": true,
		"health_checks": [
			{
				"name": "posthog-mcp-configured",
				"command": "node -e \"const m=JSON.parse(require('fs').readFileSync('.mcp.json','utf-8'));process.exit(m.mcpServers?.posthog ? 0 : 1)\""
			},
			{
				"name": "posthog-token-present",
				"command": "node -e \"const fs=require('fs');const p='.indusk/extensions/posthog/.env';if(!fs.existsSync(p))process.exit(1);process.exit(/POSTHOG_MCP_API_KEY=\\S/.test(fs.readFileSync(p,'utf-8'))?0:1)\""
			}
		]
	},
	"mcp_server": {
		"type": "http",
		"url": "POSTHOG_MCP_URL",
		"headers": {
			"Authorization": "Bearer POSTHOG_MCP_API_KEY"
		},
		"setup_instructions": [
			"1. Copy the template:",
			"   cp .indusk/extensions/posthog/.env.example .indusk/extensions/posthog/.env",
			"2. Edit .env and fill in:",
			"   - POSTHOG_MCP_API_KEY (a phx_ personal API key — Settings > Personal API Keys)",
			"   - POSTHOG_MCP_URL (https://mcp.posthog.com/mcp — routes to your region)",
			"3. Run 'indusk extensions enable posthog' again (or 'indusk update')",
			"4. Restart Claude Code to load the MCP server"
		]
	},
	"hooks": {
		"on_enable": "echo 'PostHog extension enabled.'"
	},
	"detect": {
		"mcp_server": "posthog"
	}
}
