# MCP config (contains auth tokens)
.mcp.json
# InDusk managed
# Session-specific handoff (not project knowledge)
.claude/handoff.md
# Semantic graph event log (large, local-only)
.indusk/graph/
# Eval results (local-only)
.indusk/eval/
# Extension manifests are package-owned; env files contain secrets
.indusk/extensions/
# Bundled admin app — produced by scripts/bundle-admin.js, included in
# published tarball via package.json files array, but should never be
# committed (regenerated on every build).
admin/
# Packed tarballs from `pnpm pack` — local build artifacts.
*.tgz
