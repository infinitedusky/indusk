{
	"name": "docs",
	"location": "apps/docs",
	"includeVars": [],
	"target": {
		"type": "docker-compose",
		"file": "docker-compose.yml",
		"service": "docs",
		"subdomain": "docs",
		"config": {
			"build": {
				"context": ".",
				"dockerfile": "docker/Dockerfile.vitepressdev"
			},
			"ports": ["${docs.PORT}:${docs.PORT}"],
			"volumes": ["./apps/docs/src:/app/apps/docs/src"],
			"command": "@infinitedusky/docs",
			"restart": "unless-stopped"
		}
	},
	"vars": {
		"PORT": "${docs.PORT}"
	},
	"dev": {
		"command": "pnpm dev",
		"label": "Docs"
	}
}
