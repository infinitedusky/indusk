[default]
# composable.env component for local-telemetry extension.
# Selected on the dev profile via ce; staging/prod profiles use dash0.env instead.
#
# OTLP endpoint for traces — the bundled Jaeger's HTTP receiver.
OTLP_ENDPOINT=http://localhost:4318

# OTLP protocol
OTLP_PROTOCOL=http/protobuf

# OTLP endpoint for logs — separate from traces because Jaeger doesn't
# store logs. The sibling otelcol daemon exposes its OTLP log receiver on
# a different port (auto-picked at daemon start; default 4319).
OTLP_LOGS_ENDPOINT=http://localhost:4319

# Values below are consumed by the instrumentation.ts scaffold
# (via `OTEL_EXPORTER_OTLP_*` env vars). The exact mapping is:
#   OTEL_EXPORTER_OTLP_ENDPOINT       <- OTLP_ENDPOINT
#   OTEL_EXPORTER_OTLP_PROTOCOL       <- OTLP_PROTOCOL
#   OTEL_EXPORTER_OTLP_LOGS_ENDPOINT  <- OTLP_LOGS_ENDPOINT
#
# composable.env's profile system handles the mapping; projects just
# reference the `local-telemetry` component in their contract.
