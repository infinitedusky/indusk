; networking.env — DNS and routing per environment
; OrbStack provides automatic .orb.local DNS for Docker containers
;
; Service names in docker-compose become hostnames:
;   myapp-local → myapp-local.orb.local (from host)
;   myapp-local → myapp-local (container-to-container)

[default]
DOMAIN=localhost
PROFILE_SUFFIX=-local
BASE_URL=http://localhost

[local]
DOMAIN=orb.local
PROFILE_SUFFIX=-local
BASE_URL=http://localhost

[production]
DOMAIN=example.com
PROFILE_SUFFIX=
BASE_URL=https://example.com
